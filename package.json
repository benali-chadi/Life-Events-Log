{
  "name": "life-events-log",
  "private": true,
  "scripts": {
    "mobile:start": "pnpm --filter @lel/mobile start",
    "mobile:ios": "pnpm --filter @lel/mobile ios",
    "mobile:android": "pnpm --filter @lel/mobile android",
    "mobile:web": "pnpm --filter @lel/mobile web",
    "lint": "eslint apps packages",
    "lint:fix": "eslint apps packages --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "db:generate": "pnpm --filter @lel/mobile db:generate"
  },
  "devDependencies": {
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-refresh": "^0.5.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
